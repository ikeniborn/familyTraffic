diff --git a/proxy/socks/auth_journal_test.go b/proxy/socks/auth_journal_test.go
new file mode 100644
index 0000000..b3d9bcc
--- /dev/null
+++ b/proxy/socks/auth_journal_test.go
@@ -0,0 +1,33 @@
+package socks
+
+import (
+	"bytes"
+	stderrors "errors"
+	"github.com/xtls/xray-core/common/errors"
+	"testing"
+)
+
+func TestCredentialMismatchIdentity(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		data     []byte
+		mismatch bool
+	}{
+		{"wrong", []byte{2, 1, 1, 'u', 1, 'x'}, true},
+		{"valid", []byte{2, 1, 1, 'u', 1, 'p'}, false},
+		{"truncated", []byte{2, 1, 1, 'u'}, false},
+		{"version", []byte{2, 5, 1, 'u', 1, 'x'}, false},
+		{"empty", []byte{2, 1, 0, 1, 'x'}, false},
+		{"method", []byte{0}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := ServerSession{config: &ServerConfig{AuthType: AuthType_PASSWORD, Accounts: map[string]string{"u": "p"}}}
+			var out bytes.Buffer
+			_, err := s.auth5(1, bytes.NewReader(tc.data), &out)
+			wrapped := errors.New("failed to read request").Base(err)
+			if got := stderrors.Is(wrapped, ErrInvalidCredentials); got != tc.mismatch {
+				t.Fatalf("mismatch=%v err=%v", got, err)
+			}
+		})
+	}
+}
