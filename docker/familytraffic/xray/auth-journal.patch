diff --git a/common/ftauth/journal.go b/common/ftauth/journal.go
new file mode 100644
index 0000000..6a9c26b
--- /dev/null
+++ b/common/ftauth/journal.go
@@ -0,0 +1,45 @@
+// Package ftauth writes credential-free authentication failure events.
+package ftauth
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"time"
+)
+
+// Record appends one event using a validated protocol and connection address.
+func Record(protocol string, source net.Addr) error {
+	return record("/var/log/xray/auth.log", time.Now(), protocol, source)
+}
+
+func record(path string, now time.Time, protocol string, source net.Addr) error {
+	if protocol != "http" && protocol != "socks" {
+		return errors.New("invalid authentication event protocol")
+	}
+	addr, ok := source.(*net.TCPAddr)
+	if !ok || addr == nil || addr.Zone != "" || addr.IP.To16() == nil {
+		return errors.New("invalid authentication event address")
+	}
+	line := fmt.Sprintf("%s FT_AUTH_FAILURE protocol=%s src=%s\n", now.UTC().Format("2006-01-02T15:04:05Z"), protocol, addr.IP.String())
+	file, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0600)
+	if err != nil {
+		return errors.New("authentication journal open failed")
+	}
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 {
+		file.Close()
+		return errors.New("authentication journal requires regular file mode 0600")
+	}
+	n, err := file.Write([]byte(line))
+	closeErr := file.Close()
+	if err != nil || n != len(line) {
+		return io.ErrShortWrite
+	}
+	if closeErr != nil {
+		return errors.New("authentication journal close failed")
+	}
+	return nil
+}
diff --git a/common/ftauth/journal_test.go b/common/ftauth/journal_test.go
new file mode 100644
index 0000000..c1c8cb8
--- /dev/null
+++ b/common/ftauth/journal_test.go
@@ -0,0 +1,91 @@
+package ftauth
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestJournal(t *testing.T) {
+	now := time.Date(2026, 10, 31, 12, 0, 0, 0, time.FixedZone("offset", 3600))
+	for _, ip := range []string{"192.0.2.10", "2001:0db8:0:0::1", "::ffff:192.0.2.10"} {
+		path := filepath.Join(t.TempDir(), "auth.log")
+		addr := &net.TCPAddr{IP: net.ParseIP(ip), Port: 1234}
+		if err := record(path, now, "http", addr); err != nil {
+			t.Fatal(err)
+		}
+		data, _ := os.ReadFile(path)
+		want := "2026-10-31T11:00:00Z FT_AUTH_FAILURE protocol=http src=" + addr.IP.String() + "\n"
+		if string(data) != want {
+			t.Fatalf("got %q want %q", data, want)
+		}
+		st, _ := os.Stat(path)
+		if st.Mode().Perm() != 0600 {
+			t.Fatal(st.Mode())
+		}
+		if err := os.Rename(path, path+".1"); err != nil {
+			t.Fatal(err)
+		}
+		if err := record(path, now, "socks", addr); err != nil {
+			t.Fatal(err)
+		}
+		old, _ := os.ReadFile(path + ".1")
+		if string(old) != want {
+			t.Fatal("rotated file changed")
+		}
+	}
+}
+func TestRejectUntrustedInput(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "auth.log")
+	for _, protocol := range []string{"http\nforged", "HTTP", ""} {
+		if record(path, time.Now(), protocol, &net.TCPAddr{IP: net.ParseIP("192.0.2.10")}) == nil {
+			t.Fatal("accepted protocol")
+		}
+	}
+	for _, addr := range []net.Addr{nil, &net.TCPAddr{}, &net.UnixAddr{Name: "victim\n", Net: "unix"}} {
+		if record(path, time.Now(), "http", addr) == nil {
+			t.Fatal("accepted address")
+		}
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("invalid input created file")
+	}
+}
+func TestWriteFailures(t *testing.T) {
+	addr := &net.TCPAddr{IP: net.ParseIP("192.0.2.10")}
+	dir := t.TempDir()
+	if record(dir, time.Now(), "http", addr) == nil {
+		t.Fatal("accepted directory")
+	}
+	path := filepath.Join(dir, "auth.log")
+	os.WriteFile(path, nil, 0644)
+	if record(path, time.Now(), "http", addr) == nil {
+		t.Fatal("accepted unsafe permissions")
+	}
+	if record(filepath.Join(dir, "absent", "auth.log"), time.Now(), "http", addr) == nil {
+		t.Fatal("ignored open error")
+	}
+}
+func TestConcurrentLines(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "auth.log")
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := record(path, time.Unix(0, 0), "socks", &net.TCPAddr{IP: net.ParseIP("192.0.2.10")}); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	data, _ := os.ReadFile(path)
+	line := "1970-01-01T00:00:00Z FT_AUTH_FAILURE protocol=socks src=192.0.2.10\n"
+	if string(data) != strings.Repeat(line, 100) {
+		t.Fatal("incomplete or extra lines")
+	}
+}
