--- /dev/null
+++ b/proxy/http/auth_journal_test.go
@@ -0,0 +1,24 @@
+package http
+
+import (
+	"encoding/base64"
+	"testing"
+)
+
+func TestChallengeVersusMismatch(t *testing.T) {
+	s := Server{config: &ServerConfig{Accounts: map[string]string{"u": "p"}}}
+	for _, tc := range []struct {
+		auth string
+		want bool
+	}{
+		{"", false}, {"Bearer forged", false}, {"Basic !!!", false},
+		{"Basic " + base64.StdEncoding.EncodeToString([]byte("no-colon")), false},
+		{"Basic " + base64.StdEncoding.EncodeToString([]byte("u:p")), false},
+		{"Basic " + base64.StdEncoding.EncodeToString([]byte("u:wrong")), true},
+		{"Basic " + base64.StdEncoding.EncodeToString([]byte("victim\nforged:wrong")), true},
+	} {
+		if got := s.credentialMismatch(tc.auth); got != tc.want {
+			t.Fatalf("mismatch=%v want %v", got, tc.want)
+		}
+	}
+}
