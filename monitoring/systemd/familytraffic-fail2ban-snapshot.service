[Unit]
Description=Publish read-only familyTraffic Fail2ban state
After=fail2ban.service

[Service]
Type=oneshot
User=root
Group=familytraffic-monitoring
ExecStart=/usr/bin/python3 /usr/local/lib/familytraffic-monitoring/fail2ban_snapshot.py
StateDirectory=familytraffic-fail2ban
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/familytraffic-fail2ban
