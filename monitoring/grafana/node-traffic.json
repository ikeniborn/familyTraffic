{
  "uid": "node-traffic",
  "title": "Node · Traffic",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "familytraffic",
    "traffic"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"familytraffic\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (user_id) (count_over_time(familytraffic_user_bytes_total{instance=~\"$node\"}[$__range]))))",
        "regex": "/user_id=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "inbound",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (inbound) (count_over_time(familytraffic_inbound_bytes_total{instance=~\"$node\"}[$__range]))))",
        "regex": "/inbound=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "client",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (client_ip) (count_over_time(familytraffic_access_events_total{instance=~\"$node\"}[$__range]))))",
        "regex": "/client_ip=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "destination",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (destination) (count_over_time(familytraffic_access_events_total{instance=~\"$node\"}[$__range]))))",
        "regex": "/destination=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "account_class",
        "label": "Account Class",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (account_class) (count_over_time(familytraffic_user_bytes_total{job=\"familytraffic\",instance=~\"$node\"}[$__range]))))",
        "regex": "/account_class=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "listener",
        "label": "Listener",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (listener) (count_over_time(familytraffic_frontend_bytes_total{job=\"familytraffic\",instance=~\"$node\"}[$__range]))))",
        "regex": "/listener=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "jail",
        "label": "Jail",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (jail) (count_over_time(familytraffic_fail2ban_banned{job=\"familytraffic\",instance=~\"$node\"}[$__range]))))",
        "regex": "/jail=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "protocol",
        "label": "Protocol",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (protocol) (count_over_time(familytraffic_auth_failures_total{job=\"familytraffic\",instance=~\"$node\"}[$__range]))))",
        "regex": "/protocol=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(topk(200, count by (source) (count_over_time(familytraffic_source_up{job=\"familytraffic\",instance=~\"$node\"}[$__range]))))",
        "regex": "/source=\"([^\"]+)\"/",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Collection source availability",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Filters: node, source. Other dashboard filters do not apply. 0 means unavailable. Missing data is unknown, never zero-filled.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "familytraffic_source_up{source=~\"${source:regex}\",job=\"familytraffic\",instance=~\"$node\"}",
          "legendFormat": "{{user_id}} {{account_class}} {{inbound}} {{listener}} {{direction}} {{source}} {{reason}} {{jail}} {{action}}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "up{job=\"familytraffic\",instance=~\"$node\"}",
          "legendFormat": "Prometheus scrape",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "spanNulls": false
      }
    },
    {
      "id": 3,
      "title": "Collection freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Filters: node, source. Other dashboard filters do not apply. ",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - familytraffic_last_success_timestamp_seconds{source=~\"${source:regex}\",job=\"familytraffic\",instance=~\"$node\"}",
          "legendFormat": "{{user_id}} {{account_class}} {{inbound}} {{listener}} {{direction}} {{source}} {{reason}} {{jail}} {{action}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "spanNulls": false
      }
    },
    {
      "id": 4,
      "title": "Address completeness: overflow and collection gaps",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Filters: node. Other dashboard filters do not apply. Independent quality signals. Missing series mean unknown; an absent counter must not suppress another signal. Nonzero gaps or overflow mean incomplete analytics.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (increase(familytraffic_detail_overflow_total{job=\"familytraffic\",instance=~\"$node\"}[$__range]))",
          "legendFormat": "familytraffic_detail_overflow_total",
          "format": "time_series",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by(instance) (increase(familytraffic_collection_gaps_total{job=\"familytraffic\",instance=~\"$node\"}[$__range]))",
          "legendFormat": "familytraffic_collection_gaps_total",
          "format": "time_series",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum by(instance) (increase(familytraffic_auth_collection_gaps_total{job=\"familytraffic\",instance=~\"$node\"}[$__range]))",
          "legendFormat": "familytraffic_auth_collection_gaps_total",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "spanNulls": false
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Traffic",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 6,
      "title": "Native inbound upload/download",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Filters: node, inbound. Other dashboard filters do not apply. Scope: node and inbound. Shared proxy inbound combines TLS/plaintext. Native Vision counters can update on flow closure.",
      "gridPos": {
